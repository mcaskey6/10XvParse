# 10XvParse — 10x Genomics vs Parse Biosciences preprocessing workflow.
#
# Takes paired 10x and Parse single-cell RNA-seq datasets from raw reads to
# gene-count matrices (and optional gene-body coverage plots), subsampling the
# technologies to a matched sequencing depth so they can be compared fairly.
#
# CONFIGURE
#   Config/config.yaml        `threads`, and `analyses:` mapping each analysis
#                             name to its Config/<analysis>.yaml.
#   Config/indexes.yaml       per-species reference URLs. A dual-species
#                             ("barnyard") reference sets `barnyard: true` and adds
#                             *_2 keys for the second species.
#   Config/<analysis>.yaml   one analysis: each assay's technology (`tech:`), read
#                             source (an `SRA:`/`ERA:`/`local:` block), `species:`,
#                             optional `read_num:`, `wells:`, `trim:`, and a
#                             `comparisons:` block listing which 10x/Parse assays
#                             are subsampled together (and to how many depths).
#   To add an analysis: write its Config/<analysis>.yaml and register it under
#   `analyses:` — no workflow changes needed.
#
# RUN
#   snakemake --workflow-profile workflow/profiles/default <targets>
#   Targets: `all` (count matrices for every configured analysis), a specific
#   Data/<analysis>/<assay>/kb_python/<out>/counts_unfiltered/adata.h5ad, or a
#   gene-body plot Data/<analysis>/Plots/<tag>.geneBodyCoverage.txt.
#
# PIPELINE (per assay)
#   fetch reads -> splitcode remultiplex -> [Parse: barcode filter + polyT/randO
#   split] -> subsample to the group's shared depth -> kb count (kallisto|bustools)
#   -> adata.h5ad. Hashtag (feature-barcode) assays instead use a kite index.
#   Gene-body coverage aligns the subsampled reads with STARsolo and runs RSeQC.
#
# LAYOUT
#   workflow/paths.py           every input/output path (the naming conventions).
#   workflow/config_helpers.py  reading + interpreting the analysis configs.
#   workflow/scripts/           the few genuinely-Python steps; every other step is
#                               a single-command `shell:` rule.

import re
import sys

import yaml

sys.path.insert(0, workflow.basedir)  # make paths.py / config_helpers.py importable
import paths
import config_helpers as ch


configfile: "Config/config.yaml"
configfile: "Config/indexes.yaml"

THREADS = config.get("threads", 8)
INDEXES = config["indexes"]

# Load each analysis's config (Config/analysisN.yaml) keyed by analysis name.
ANALYSES = {}
for _name, _cfg_path in config["analyses"].items():
    with open(_cfg_path) as _f:
        ANALYSES[_name] = yaml.safe_load(_f)


def _assays(cfg):
    return [a for a in cfg["tech"] if a != "wells"]


def _assays_of_type(kind):
    return sorted({a for cfg in ANALYSES.values() for a in _assays(cfg)
                   if ch.assay_type(cfg, a) == kind})


ALL_ASSAYS = sorted({a for cfg in ANALYSES.values() for a in _assays(cfg)})
TENX_ASSAYS = _assays_of_type("tenx")
PARSE_ASSAYS = _assays_of_type("parse")
HASHTAG_ASSAYS = _assays_of_type("hashtags")
# 10x and hashtag libraries carry no sublibrary barcode, so they share the same
# (barcode-free) remultiplexing rule; they differ only in pseudoalignment (a nac
# gene index for 10x, a kite feature index for hashtags).
NOBC_ASSAYS = sorted(set(TENX_ASSAYS) | set(HASHTAG_ASSAYS))


def _re(assays):
    return "|".join(map(re.escape, assays)) or "^$"


TENX_RE = _re(TENX_ASSAYS)
PARSE_RE = _re(PARSE_ASSAYS)
HASHTAG_RE = _re(HASHTAG_ASSAYS)
NOBC_RE = _re(NOBC_ASSAYS)

# A single-species reference is downloaded directly; a barnyard (dual-species) one
# is built by prefixing and concatenating two species. Which rule applies is chosen
# by the `barnyard:` flag on the species in Config/indexes.yaml.
BARNYARD_SPECIES = sorted(sp for sp, v in INDEXES.items() if v.get("barnyard"))
SINGLE_SPECIES = sorted(sp for sp in INDEXES if sp not in BARNYARD_SPECIES)
BARNYARD_RE = _re(BARNYARD_SPECIES)
SINGLE_RE = _re(SINGLE_SPECIES)


wildcard_constraints:
    # Any analysis name (the keys under `analyses:` in Config/config.yaml); it names a
    # single path segment, so anything but a path separator. The tightly-constrained
    # `assay` (a known assay name) keeps Data/{analysis}/{assay}/... unambiguous.
    analysis=r"[^/]+",
    assay="|".join(map(re.escape, ALL_ASSAYS)) or r"[A-Za-z0-9_]+",
    srr=r"[A-Z]{3}\d+",
    species=r"[a-z_]+",
    kind="polyT|randO",  # the only barcode-split subsample kinds
    read=r"[01]",
    stag=r"(_[A-Za-z0-9]+)?",  # subsample depth token: "" or "_<comparison tag>"
    tag=r"[A-Za-z0-9]*",       # raw comparison tag ("" for the untagged group)
    pk=r"parse|polyT|randO",   # parse read subset for a STARsolo BAM
    tech=r"10X[A-Za-z0-9]+",   # a 10x tech string (10XV3/10XV4) for the barcode whitelist


# --------------------------------------------------------------------------- #
# helpers over the loaded config
# --------------------------------------------------------------------------- #

def cfg_of(wc):
    return ANALYSES[wc.analysis]


def SP(wc):
    return ch.species(cfg_of(wc))


def source_read_nums(wc):
    """(R1, R2) source read-number suffixes for this accession — the fasterq-dump
    output suffix (SRA) or the ENA FASTQ suffix (ERA) — honouring any per-sublibrary
    override, the assay default otherwise."""
    cfg = cfg_of(wc)
    _src, accs, subs = ch.accessions_for(cfg, wc.assay)
    idx = accs.index(wc.srr)
    if idx < len(subs):
        return ch.read_nums_for(cfg, wc.assay, subs[idx])
    return ch.default_read_nums(cfg, wc.assay)


def library_rows(wc):
    """(name, r1, r2) per library for an assay, source-aware. For SRA/ERA the reads
    are the accession-named dumped FASTQs (produced by dump/download_era); for a
    local assay they are the committed ``[R1, R2]`` files listed in the ``local:``
    config block (arbitrary filenames, in the assay's Dumped dir — no renaming)."""
    cfg = cfg_of(wc)
    src, names, subs = ch.accessions_for(cfg, wc.assay)
    if src == "local":
        d = paths.dumped_dir(wc.analysis, wc.assay)
        return [(name, f"{d}/{r1}", f"{d}/{r2}")
                for name, r1, r2 in ch.local_libraries(cfg, wc.assay)]
    labels = subs if subs else list(names)
    return [
        (labels[i],
         paths.dumped_fastq(wc.analysis, wc.assay, acc, "R1"),
         paths.dumped_fastq(wc.analysis, wc.assay, acc, "R2"))
        for i, acc in enumerate(names)
    ]


def dumped_fastqs(wc):
    """All per-library FASTQs for an assay, aggregated for multiplexing."""
    return [f for _name, r1, r2 in library_rows(wc) for f in (r1, r2)]


def assay_sublibraries(wc):
    """Sublibrary label per library, in batch order — source-aware (the Lib{i} names
    for a local assay, else the config's sublibraries/accessions)."""
    return [name for name, _r1, _r2 in library_rows(wc)]


def kb_index_input(wc):
    """The kb (kallisto) index files, keyed by this analysis's species."""
    s = SP(wc)
    return {
        "index": paths.index_file(s),
        "t2g": paths.t2g_file(s),
        "cdna": paths.cdna_file(s),
        "nascent": paths.nascent_file(s),
    }


def main_subsample_source(wc):
    """The one full-depth read file feeding a main subsample job: the 10x
    multiplexed FASTQ for a tenx assay, the barcode-filtered FASTQ for parse."""
    r = int(wc.read)
    if ch.assay_type(cfg_of(wc), wc.assay) == "tenx":
        return paths.tenx_multiplexed(wc.analysis, wc.assay)[r]
    return paths.parse_filtered(wc.analysis, wc.assay)[r]


def tenx_kb_fastqs(wc):
    """Input FASTQs for a tenx kb count, chosen by the output leaf. A sampled leaf
    is ``sampled_10x{stag}_out``; the depth token selects the ``Sampled{stag}`` dir."""
    if wc.leaf == "10x_out":
        return paths.tenx_multiplexed(wc.analysis, wc.assay)
    _sub, stag = paths.parse_sampled_leaf(wc.leaf)
    return paths.sampled_fastqs(wc.analysis, wc.assay, stag)


def parse_kb_fastqs(wc):
    """Input FASTQs for a parse kb count, chosen by the output leaf. Sampled leaves
    are ``sampled_{parse|polyT|randO}{stag}_out``: the read subset (empty -> the
    assay-named main FASTQ) and depth token come from ``paths.parse_sampled_leaf``."""
    if wc.leaf == "parse_out":
        return paths.parse_filtered(wc.analysis, wc.assay)
    sub, stag = paths.parse_sampled_leaf(wc.leaf)
    kind = "" if sub == "parse" else sub
    return paths.sampled_fastqs(wc.analysis, wc.assay, stag, kind)


def hashtags_kb_fastqs(wc):
    """R1 + R2 for a kite kb count. R2 is trimmed to the feature-barcode length
    when the config sets a trim for this assay, otherwise the multiplexed R2."""
    r1 = paths.tenx_multiplexed(wc.analysis, wc.assay)[0]
    if ch.r2_trim_length(cfg_of(wc), wc.assay) is not None:
        r2 = paths.hashtags_trimmed_r2(wc.analysis, wc.assay)
    else:
        r2 = paths.tenx_multiplexed(wc.analysis, wc.assay)[1]
    return [r1, r2]


def _group_first_reads(cfg, analysis, comp):
    """First-read processed FASTQ of every assay in a comparison group — the files
    whose read counts set the group's subsample depth (10x multiplexed read; parse
    filtered/polyT/randO reads)."""
    files = []
    for assay in comp.get("tenx", []):
        files.append(paths.tenx_multiplexed(analysis, assay)[0])
    for assay in comp.get("parse", []):
        files.append(paths.parse_filtered(analysis, assay)[0])
        files.append(paths.parse_split(analysis, assay, "polyT")[0])
        files.append(paths.parse_split(analysis, assay, "randO")[0])
    return files


def all_first_reads(wc):
    """Every first-read FASTQ to count for an analysis, de-duplicated — the inputs
    to the read_counts file (a shared assay's file appears in more than one group)."""
    cfg = cfg_of(wc)
    seen = []
    for comp in ch.comparisons(cfg):
        for f in _group_first_reads(cfg, wc.analysis, comp):
            if f not in seen:
                seen.append(f)
    return seen


def group_first_reads(wc):
    """First-read FASTQs of this subsample job's group — the group is named by the
    output tag (a tagged output) or is the single group the assay belongs to. The
    job takes the minimum of their read counts from the read_counts file."""
    cfg = cfg_of(wc)
    comp = ch.subsample_group(cfg, wc.assay, wc.stag)
    return _group_first_reads(cfg, wc.analysis, comp)


# --------------------------------------------------------------------------- #
# targets
# --------------------------------------------------------------------------- #

def all_targets():
    targets = []
    for name, cfg in ANALYSES.items():
        for assay in _assays(cfg):
            t = ch.assay_type(cfg, assay)
            if t == "tenx":
                targets.append(paths.kb_h5ad(name, assay, "10x_out"))
            elif t == "parse":
                targets.append(paths.kb_h5ad(name, assay, "parse_out"))
            elif t == "hashtags":
                targets.append(paths.kb_h5ad(name, assay, "10x_hashtags_out"))
        for comp in ch.comparisons(cfg):
            tag = comp.get("tag", "")
            for assay in comp.get("tenx", []):
                ostag = ch.output_stag(cfg, assay, tag)
                targets.append(paths.kb_h5ad(name, assay, paths.sampled_leaf("10x", ostag)))
            for assay in comp.get("parse", []):
                ostag = ch.output_stag(cfg, assay, tag)
                for k in ("parse", "polyT", "randO"):
                    targets.append(paths.kb_h5ad(name, assay, paths.sampled_leaf(k, ostag)))
    return targets


def genebody_targets():
    """One gene-body coverage plot per comparison group (its one tenx + one parse)."""
    targets = []
    for name, cfg in ANALYSES.items():
        for comp in ch.comparisons(cfg):
            if comp.get("tenx") and comp.get("parse"):
                targets.append(paths.genebody_marker(name, comp.get("tag", "")))
    return targets


rule all:
    input:
        all_targets()


# --------------------------------------------------------------------------- #
# reference + kb index (per species)
# --------------------------------------------------------------------------- #

rule download_reference:
    wildcard_constraints:
        species=SINGLE_RE,
    output:
        fa=paths.genome_file("{species}"),
        gtf=paths.gtf_file("{species}"),
    params:
        fasta_url=lambda wc: INDEXES[wc.species]["fasta"],
        gtf_url=lambda wc: INDEXES[wc.species]["gtf"],
    shell:
        "curl -L -f -o {output.fa} {params.fasta_url} && "
        "curl -L -f -o {output.gtf} {params.gtf_url}"


rule barnyard_reference:
    # Build a dual-species ("barnyard") reference for species "{sp1}_{sp2}": download
    # both species, prefix every FASTA sequence ID and the GTF seqname + gene_id /
    # gene_name with the uppercased species label (e.g. HUMAN_, MOUSE_) so the two
    # genomes don't collide, then concatenate into one gzipped FASTA + GTF.
    wildcard_constraints:
        species=BARNYARD_RE,
    output:
        fa=paths.genome_file("{species}"),
        gtf=paths.gtf_file("{species}"),
    params:
        fasta_url=lambda wc: INDEXES[wc.species]["fasta"],
        gtf_url=lambda wc: INDEXES[wc.species]["gtf"],
        fasta_url_2=lambda wc: INDEXES[wc.species]["fasta_2"],
        gtf_url_2=lambda wc: INDEXES[wc.species]["gtf_2"],
        p1=lambda wc: wc.species.split("_", 1)[0].upper(),
        p2=lambda wc: wc.species.split("_", 1)[1].upper(),
        tmp=lambda wc: f"{paths.index_dir(wc.species)}/tmp",
    shell:
        r"""
        mkdir -p {params.tmp}
        curl -L -f -o {params.tmp}/sp1.fa.gz {params.fasta_url}
        curl -L -f -o {params.tmp}/sp1.gtf.gz {params.gtf_url}
        curl -L -f -o {params.tmp}/sp2.fa.gz {params.fasta_url_2}
        curl -L -f -o {params.tmp}/sp2.gtf.gz {params.gtf_url_2}
        ( zcat {params.tmp}/sp1.fa.gz | sed 's/^>/>{params.p1}_/' ; \
          zcat {params.tmp}/sp2.fa.gz | sed 's/^>/>{params.p2}_/' ) | gzip > {output.fa}
        ( zcat {params.tmp}/sp1.gtf.gz | sed -E '/^#/!{{ s/^/{params.p1}_/; s/(gene_id ")/\1{params.p1}_/; s/(gene_name ")/\1{params.p1}_/ }}' ; \
          zcat {params.tmp}/sp2.gtf.gz | sed -E '/^#/!{{ s/^/{params.p2}_/; s/(gene_id ")/\1{params.p2}_/; s/(gene_name ")/\1{params.p2}_/ }}' ) | gzip > {output.gtf}
        rm -f {params.tmp}/sp1.fa.gz {params.tmp}/sp1.gtf.gz {params.tmp}/sp2.fa.gz {params.tmp}/sp2.gtf.gz
        """


rule kb_ref:
    input:
        fa=paths.genome_file("{species}"),
        gtf=paths.gtf_file("{species}"),
    output:
        index=paths.index_file("{species}"),
        t2g=paths.t2g_file("{species}"),
        cdna=paths.cdna_file("{species}"),
        nascent=paths.nascent_file("{species}"),
        cdna_fa=paths.cdna_fasta_file("{species}"),
        nascent_fa=paths.nascent_fasta_file("{species}"),
    shell:
        "kb ref --workflow nac -i {output.index} -g {output.t2g} "
        "-c1 {output.cdna} -c2 {output.nascent} "
        "-f1 {output.cdna_fa} -f2 {output.nascent_fa} "
        "{input.fa} {input.gtf}"


# --------------------------------------------------------------------------- #
# download -> dump -> multiplex (per accession, then aggregated)
# --------------------------------------------------------------------------- #

# SRA (SRR/DRR accessions): prefetch -> fasterq-dump. ENA (ERR) uses download_era
# below instead; the accession prefix selects the source.
rule prefetch:
    wildcard_constraints:
        srr=r"[DS]RR\d+",
    output:
        # raw download, consumed only by `dump`
        sra=temp(paths.sra_file("{analysis}", "{assay}", "{srr}")),
    params:
        outdir=lambda wc: paths.sra_dir(wc.analysis, wc.assay),
    shell:
        "prefetch {wildcards.srr} --max-size u -O {params.outdir}"


rule dump:
    wildcard_constraints:
        srr=r"[DS]RR\d+",
    input:
        sra=paths.sra_file("{analysis}", "{assay}", "{srr}"),
    output:
        # raw reads, consumed only by multiplexing
        r1=temp(paths.dumped_fastq("{analysis}", "{assay}", "{srr}", "R1")),
        r2=temp(paths.dumped_fastq("{analysis}", "{assay}", "{srr}", "R2")),
    params:
        dumped=lambda wc: paths.dumped_dir(wc.analysis, wc.assay),
        tmp=lambda wc: paths.tmp_dir(wc.analysis, wc.assay),
        r1n=lambda wc: source_read_nums(wc)[0],
        r2n=lambda wc: source_read_nums(wc)[1],
    threads: THREADS
    shell:
        "mkdir -p {params.tmp} && "
        "fasterq-dump --outdir {params.dumped} --temp {params.tmp} "
        "--outfile {wildcards.srr}.fasta --split-files --skip-technical -f "
        "{input.sra} --threads {threads} --fasta-unsorted && "
        "pigz -c -p {threads} {params.dumped}/{wildcards.srr}_{params.r1n}.fasta > {output.r1} && "
        "pigz -c -p {threads} {params.dumped}/{wildcards.srr}_{params.r2n}.fasta > {output.r2} && "
        "rm -f {params.dumped}/{wildcards.srr}_*.fasta"


rule download_era:
    # ENA hosts paired FASTQs directly on its FTP, so ERR accessions are downloaded
    # rather than prefetched/dumped. Reads are written to the same per-accession
    # FASTQ names the SRA path produces, so multiplexing is source-agnostic.
    wildcard_constraints:
        srr=r"ERR\d+",
    output:
        # raw reads, consumed only by multiplexing
        r1=temp(paths.dumped_fastq("{analysis}", "{assay}", "{srr}", "R1")),
        r2=temp(paths.dumped_fastq("{analysis}", "{assay}", "{srr}", "R2")),
    params:
        url1=lambda wc: ch.era_ftp_url(wc.srr, source_read_nums(wc)[0]),
        url2=lambda wc: ch.era_ftp_url(wc.srr, source_read_nums(wc)[1]),
    shell:
        "curl -L -f -o {output.r1} {params.url1} && "
        "curl -L -f -o {output.r2} {params.url2}"


rule write_batch:
    output:
        batch=paths.batch_file("{analysis}", "{assay}"),
    params:
        rows=library_rows,
        # Parse remultiplexes with a sublibrary barcode; 10x/hashtags do not.
        bclen=lambda wc: ch.assay_bclen(cfg_of(wc), wc.assay),
    script:
        "scripts/write_batch.py"


rule multiplex_tenx:
    # 10x and hashtag libraries both multiplex without a sublibrary barcode.
    wildcard_constraints:
        assay=NOBC_RE,
    input:
        batch=paths.batch_file("{analysis}", "{assay}"),
        fastqs=dumped_fastqs,
    output:
        paths.tenx_multiplexed("{analysis}", "{assay}"),
    threads: THREADS
    shell:
        "splitcode --remultiplex --nFastqs=2 --gzip "
        "-o {output[0]},{output[1]} --no-outb {input.batch} -t {threads}"


rule multiplex_parse:
    # Parse libraries are remultiplexed with a per-sublibrary "4th-round" barcode
    # (splitcode --bclen), which lets sublibraries share one FASTQ without their
    # cells colliding. splitcode embeds that barcode in the first output file, so
    # both the batch read-order and the -o outputs are swapped to put the barcode
    # read first.
    wildcard_constraints:
        assay=PARSE_RE,
    input:
        batch=paths.batch_file("{analysis}", "{assay}"),
        fastqs=dumped_fastqs,
    output:
        # generic-named remultiplex output, consumed only by parse_filter
        [temp(f) for f in paths.parse_multiplexed("{analysis}", "{assay}")],
    params:
        bclen=lambda wc: ch.assay_bclen(cfg_of(wc), wc.assay),
    threads: THREADS
    shell:
        "splitcode --remultiplex --nFastqs=2 --gzip "
        "-o {output[1]},{output[0]} --bclen={params.bclen} {input.batch} -t {threads}"


# --------------------------------------------------------------------------- #
# Parse config generation + barcode filtering / splitting
# --------------------------------------------------------------------------- #

rule parse_configs:
    wildcard_constraints:
        assay=PARSE_RE,
    output:
        generated=paths.parse_generated_files("{analysis}", "{assay}"),
        splitcode_config=paths.parse_splitcode_config("{analysis}", "{assay}"),
        keep=paths.parse_keep_file("{analysis}", "{assay}"),
        rando_keep=paths.parse_randOpolyT_keep_file("{analysis}", "{assay}"),
        x_string=paths.parse_x_string("{analysis}", "{assay}"),
    params:
        kit=lambda wc: ch.technology(cfg_of(wc), wc.assay),
        parse_info_dir=paths.PARSE_INFO_DIR,
        wells=lambda wc: ch.wells(cfg_of(wc), wc.assay),
        sublibraries=assay_sublibraries,
        out_dir=lambda wc: paths.generated_dir(wc.analysis, wc.assay),
        filtered_prefix=lambda wc: f"{paths.processed_dir(wc.analysis, wc.assay)}/{wc.assay}",
        randO_prefix=lambda wc: f"{paths.processed_dir(wc.analysis, wc.assay)}/randO",
        polyT_prefix=lambda wc: f"{paths.processed_dir(wc.analysis, wc.assay)}/polyT",
    script:
        "scripts/parse_configs.py"


rule parse_filter:
    wildcard_constraints:
        assay=PARSE_RE,
    input:
        multiplexed=paths.parse_multiplexed("{analysis}", "{assay}"),
        config=paths.parse_splitcode_config("{analysis}", "{assay}"),
        keep=paths.parse_keep_file("{analysis}", "{assay}"),
        r1_R=paths.parse_r1_R("{analysis}", "{assay}"),
        r1_T=paths.parse_r1_T("{analysis}", "{assay}"),
    output:
        paths.parse_filtered("{analysis}", "{assay}"),
    threads: THREADS
    shell:
        "splitcode -c {input.config} --keep-grp {input.keep} --nFastqs=2 --gzip "
        "--no-output --no-outb {input.multiplexed} -t {threads}"


rule parse_split:
    wildcard_constraints:
        assay=PARSE_RE,
    input:
        filtered=paths.parse_filtered("{analysis}", "{assay}"),
        config=paths.parse_splitcode_config("{analysis}", "{assay}"),
        keep=paths.parse_randOpolyT_keep_file("{analysis}", "{assay}"),
    output:
        # full-depth polyT/randO reads; kb/STAR use the *sampled* versions, so these
        # are consumed only by subsampling and read counting
        polyT=[temp(f) for f in paths.parse_split("{analysis}", "{assay}", "polyT")],
        randO=[temp(f) for f in paths.parse_split("{analysis}", "{assay}", "randO")],
    threads: THREADS
    shell:
        "splitcode -c {input.config} --keep {input.keep} --nFastqs=2 --gzip "
        "--no-output --no-outb {input.filtered} -t {threads}"


# --------------------------------------------------------------------------- #
# subsampling: within each comparison group, every assay is downsampled to the
# group's shared minimum read count, so 10x and Parse are compared at equal depth.
# Read counts are cached once per analysis (read_counts), then each read is a
# separate seqtk job so they can run in parallel.
# --------------------------------------------------------------------------- #

rule read_counts:
    # One "<fastq> <read_count>" line per first-read processed FASTQ, for every
    # assay in the analysis. Subsample jobs read the minimum over their own group's
    # files from this; the file itself is group-agnostic.
    input:
        all_first_reads,
    output:
        paths.read_counts_file("{analysis}"),
    shell:
        r"""for f in {input:q}; do echo "$f $(( $(zcat "$f" | wc -l) / 4 ))"; done > {output}"""


rule subsample_main:
    # Subsample one read of an assay's main FASTQ (10x multiplexed or Parse-filtered)
    # to its comparison group's depth: the minimum read count over the group's
    # first-read files (params.group_reads), read from read_counts. The output path
    # gets a depth token ({stag}) only when the same assay is subsampled at more than
    # one depth (otherwise the assay directory already keeps depths apart).
    # `seqtk sample -2` is two-pass: it selects the reads by index rather than
    # holding them in memory, so even a very deep subsample stays light on RAM. Seed
    # 42 makes it reproducible. `threads` bounds how many subsample jobs run at once.
    input:
        fastq=main_subsample_source,
        counts=paths.read_counts_file("{analysis}"),
    output:
        paths.sampled_fastq("{analysis}", "{assay}", "{read}", "{stag}"),
    params:
        group_reads=group_first_reads,
    threads: THREADS
    shell:
        "N=$(for f in {params.group_reads}; do awk -v f=\"$f\" '$1==f{{print $2}}' {input.counts}; done | sort -n | head -1); "
        "seqtk sample -2 -s 42 {input.fastq} $N | pigz -p {threads} > {output}"


rule subsample_parse_split:
    # One read of a barcode-split (polyT/randO) subsample to its group's depth.
    wildcard_constraints:
        assay=PARSE_RE,
    input:
        fastq=lambda wc: paths.parse_split(wc.analysis, wc.assay, wc.kind)[int(wc.read)],
        counts=paths.read_counts_file("{analysis}"),
    output:
        paths.sampled_fastq("{analysis}", "{assay}", "{read}", "{stag}", "{kind}"),
    params:
        group_reads=group_first_reads,
    threads: THREADS
    shell:
        "N=$(for f in {params.group_reads}; do awk -v f=\"$f\" '$1==f{{print $2}}' {input.counts}; done | sort -n | head -1); "
        "seqtk sample -2 -s 42 {input.fastq} $N | pigz -p {threads} > {output}"


# --------------------------------------------------------------------------- #
# pseudoalignment (kb count). One rule per tech, over full + all sampled depths
# via the {leaf} output-dir wildcard. Parse runs use -r and emit a second
# _modified h5ad.
# --------------------------------------------------------------------------- #

rule kb_count_tenx:
    wildcard_constraints:
        assay=TENX_RE,
        leaf=r"10x_out|sampled_10x(_[A-Za-z0-9]+)?_out",
    input:
        unpack(kb_index_input),
        fastqs=tenx_kb_fastqs,
    output:
        h5ad=paths.kb_h5ad("{analysis}", "{assay}", "{leaf}"),
    params:
        out=lambda wc: paths.kb_out(wc.analysis, wc.assay, wc.leaf),
        tech=lambda wc: ch.technology(cfg_of(wc), wc.assay),
    threads: THREADS
    shell:
        "kb count --overwrite --h5ad --workflow=nac -t {threads} "
        "-i {input.index} -g {input.t2g} -c1 {input.cdna} -c2 {input.nascent} "
        "-x {params.tech} -o {params.out} {input.fastqs}"


rule kb_count_parse:
    wildcard_constraints:
        assay=PARSE_RE,
        leaf=r"parse_out|sampled_(parse|polyT|randO)(_[A-Za-z0-9]+)?_out",
    input:
        unpack(kb_index_input),
        fastqs=parse_kb_fastqs,
        onlist=paths.parse_onlist("{analysis}", "{assay}"),
        replace=paths.parse_replace("{analysis}", "{assay}"),
        x_string=paths.parse_x_string("{analysis}", "{assay}"),
    output:
        h5ad=paths.kb_h5ad("{analysis}", "{assay}", "{leaf}"),
        h5ad_modified=paths.kb_h5ad_modified("{analysis}", "{assay}", "{leaf}"),
    params:
        out=lambda wc: paths.kb_out(wc.analysis, wc.assay, wc.leaf),
    threads: THREADS
    shell:
        "kb count --overwrite --h5ad --workflow=nac --strand=forward --parity=single "
        "-w {input.onlist} -t {threads} -r {input.replace} "
        "-i {input.index} -g {input.t2g} -c1 {input.cdna} -c2 {input.nascent} "
        "-x $(cat {input.x_string}) -o {params.out} {input.fastqs}"


# --------------------------------------------------------------------------- #
# hashtags (feature barcodes): a per-assay kite index from the committed
# hashtags.tsv, optional R2 trim, then a single full-depth kite kb count.
# --------------------------------------------------------------------------- #

rule kite_ref:
    wildcard_constraints:
        assay=HASHTAG_RE,
    input:
        tsv=paths.hashtags_tsv("{analysis}", "{assay}"),
    output:
        index=paths.hashtags_index_file("{analysis}", "{assay}"),
        t2g=paths.hashtags_t2g_file("{analysis}", "{assay}"),
        cdna=paths.hashtags_cdna_fasta_file("{analysis}", "{assay}"),
    shell:
        "kb ref --workflow kite --overwrite "
        "-i {output.index} -g {output.t2g} -f1 {output.cdna} {input.tsv}"


rule trim_r2:
    # Trim R2 to the feature-barcode length so poly-A -> genomic k-mers don't
    # collide with kite index entries. Only built when the config sets a trim.
    wildcard_constraints:
        assay=HASHTAG_RE,
    input:
        r2=lambda wc: paths.tenx_multiplexed(wc.analysis, wc.assay)[1],
    output:
        paths.hashtags_trimmed_r2("{analysis}", "{assay}"),
    params:
        n=lambda wc: ch.r2_trim_length(cfg_of(wc), wc.assay),
    threads: THREADS
    shell:
        "seqtk trimfq -L {params.n} {input.r2} | pigz -p {threads} > {output}"


rule kb_count_hashtags:
    wildcard_constraints:
        assay=HASHTAG_RE,
        leaf="10x_hashtags_out",
    input:
        index=paths.hashtags_index_file("{analysis}", "{assay}"),
        t2g=paths.hashtags_t2g_file("{analysis}", "{assay}"),
        fastqs=hashtags_kb_fastqs,
    output:
        h5ad=paths.kb_h5ad("{analysis}", "{assay}", "{leaf}"),
    params:
        out=lambda wc: paths.kb_out(wc.analysis, wc.assay, wc.leaf),
        tech=lambda wc: ch.technology(cfg_of(wc), wc.assay),
    threads: THREADS
    shell:
        "kb count --workflow kite --overwrite --h5ad -t {threads} "
        "-i {input.index} -g {input.t2g} -x {params.tech} "
        "-o {params.out} {input.fastqs}"


# --------------------------------------------------------------------------- #
# gene-body coverage: STAR index + reference BED + housekeeping filter, then
# STARsolo BAMs (one 10x + parse/polyT/randO per comparison group) fed to RSeQC's
# geneBody_coverage.py. Uses the group's SUBSAMPLED reads.
# --------------------------------------------------------------------------- #

def _pk_kind(pk):
    # STARsolo parse subset -> the sampled-FASTQ kind ("" for the main parse read).
    return "" if pk == "parse" else pk


def genebody_bams(wc):
    """The four BAMs for a comparison group's coverage plot: its 10x (tagged only
    when that 10x is multiply-subsampled) + the parse/polyT/randO subsets."""
    cfg = cfg_of(wc)
    comp = ch.group_by_tag(cfg, wc.tag)
    tenx, parse = comp["tenx"][0], comp["parse"][0]
    tstag = ch.output_stag(cfg, tenx, wc.tag)
    return [
        paths.star_bam(wc.analysis, tenx, "10x", tstag),
        paths.star_bam(wc.analysis, parse, "parse"),
        paths.star_bam(wc.analysis, parse, "polyT"),
        paths.star_bam(wc.analysis, parse, "randO"),
    ]


rule unzip_genome:
    input:
        paths.genome_file("{species}"),
    output:
        paths.genome_fasta_unzipped("{species}"),
    shell:
        "gunzip -kc {input} > {output}"


rule unzip_gtf:
    input:
        paths.gtf_file("{species}"),
    output:
        paths.gtf_unzipped("{species}"),
    shell:
        "gunzip -kc {input} > {output}"


rule star_index:
    input:
        fa=paths.genome_fasta_unzipped("{species}"),
        gtf=paths.gtf_unzipped("{species}"),
    output:
        paths.star_index_marker("{species}"),
    params:
        genomedir=lambda wc: paths.star_index_dir(wc.species),
    threads: THREADS
    shell:
        "STAR --runThreadN {threads} --runMode genomeGenerate "
        "--genomeDir {params.genomedir} --genomeFastaFiles {input.fa} --sjdbGTFfile {input.gtf}"


rule gtf_to_bed:
    input:
        paths.gtf_unzipped("{species}"),
    output:
        paths.bed_file("{species}"),
    shell:
        "gffread {input} --bed > {output}"


rule housekeeping_genes:
    # HRT Atlas housekeeping transcript IDs (one or two species). The CSV uses ','
    # or ';' as delimiter and the transcript ID is column 1; strip the version.
    output:
        paths.hk_genes_file("{species}"),
    params:
        urls=lambda wc: " ".join(
            u for u in (INDEXES[wc.species].get("hrt_atlas_url"),
                        INDEXES[wc.species].get("hrt_atlas_url_2")) if u),
    shell:
        r"""for u in {params.urls}; do curl -sSL "$u"; done """
        r"""| awk -F'[,;]' 'NR>1 || FNR>1 {{split($1,a,"."); if(a[1]!="") print a[1]}}' """
        r"""| sort -u > {output}"""


rule housekeeping_bed:
    # Subset the reference BED to housekeeping transcripts, stripping any barnyard
    # HUMAN_/MOUSE_ prefix and version from the BED's transcript id (column 4).
    input:
        bed=paths.bed_file("{species}"),
        hk=paths.hk_genes_file("{species}"),
    output:
        paths.hk_bed_file("{species}"),
    shell:
        r"""awk 'NR==FNR{{hk[$1]=1; next}} """
        r"""{{tid=$4; sub(/^HUMAN_/,"",tid); sub(/^MOUSE_/,"",tid); sub(/\..*/,"",tid); """
        r"""if(tid in hk) print}}' {input.hk} {input.bed} > {output}"""


rule parse_star_params:
    wildcard_constraints:
        assay=PARSE_RE,
    input:
        x_string=paths.parse_x_string("{analysis}", "{assay}"),
    output:
        positions=paths.parse_star_positions("{analysis}", "{assay}"),
        umi=paths.parse_star_umi("{analysis}", "{assay}"),
        whitelists=paths.parse_star_whitelists("{analysis}", "{assay}"),
    params:
        generated_dir=lambda wc: paths.generated_dir(wc.analysis, wc.assay),
    script:
        "scripts/parse_star_params.py"


rule tenx_whitelist:
    # STARsolo needs the 10x cell-barcode whitelist as a plain (uncompressed) file.
    # Rather than committing the ~115 MB lists, obtain each from the gzipped copy
    # kb-python already ships (via its ngs_tools dependency) and decompress it. This
    # is the SAME whitelist kb count uses as its barcode-correction on-list, so the
    # STARsolo and kb-python runs stay consistent by construction. kb_python.config
    # resolves the installed archive path for a tech string; no download, no manual step.
    output:
        paths.tenx_whitelist("{tech}"),
    shell:
        r"""archive=$(python -c "from kb_python.config import TECHNOLOGIES_MAPPING as T; """
        r"""print(T['{wildcards.tech}'].chemistry.whitelist_path)") && """
        r"""gunzip -c "$archive" > {output}"""


rule starsolo_tenx:
    # STARsolo (CB_UMI_Simple) on a group's subsampled 10x reads. readFilesIn is
    # cDNA (R2) then barcode (R1). {stag} tags a multiply-subsampled 10x.
    wildcard_constraints:
        assay=TENX_RE,
    input:
        idx=lambda wc: paths.star_index_marker(SP(wc)),
        whitelist=lambda wc: paths.tenx_whitelist(ch.technology(cfg_of(wc), wc.assay)),
        r_cdna=lambda wc: paths.sampled_fastq(wc.analysis, wc.assay, 1, wc.stag),
        r_bc=lambda wc: paths.sampled_fastq(wc.analysis, wc.assay, 0, wc.stag),
    output:
        bam=paths.star_bam("{analysis}", "{assay}", "10x", "{stag}"),
    params:
        genomedir=lambda wc: paths.star_index_dir(SP(wc)),
        prefix=lambda wc: paths.star_prefix(wc.analysis, wc.assay, "10x", wc.stag),
    threads: THREADS
    shell:
        "mkdir -p $(dirname {params.prefix}) && "
        "STAR --soloType CB_UMI_Simple --soloCBwhitelist {input.whitelist} "
        "--soloBarcodeReadLength 0 --runThreadN {threads} --genomeDir {params.genomedir} "
        "--outFileNamePrefix {params.prefix} --readFilesIn {input.r_cdna} {input.r_bc} "
        "--readFilesCommand zcat --outSAMtype BAM SortedByCoordinate"


rule starsolo_parse:
    # STARsolo (CB_UMI_Complex) on a parse read subset. CB/UMI positions and the
    # whitelist order come from parse_star_params (derived from the x_string).
    wildcard_constraints:
        assay=PARSE_RE,
    input:
        idx=lambda wc: paths.star_index_marker(SP(wc)),
        r0=lambda wc: paths.sampled_fastq(wc.analysis, wc.assay, 0, "", _pk_kind(wc.pk)),
        r1=lambda wc: paths.sampled_fastq(wc.analysis, wc.assay, 1, "", _pk_kind(wc.pk)),
        positions=paths.parse_star_positions("{analysis}", "{assay}"),
        umi=paths.parse_star_umi("{analysis}", "{assay}"),
        whitelists=paths.parse_star_whitelists("{analysis}", "{assay}"),
    output:
        bam=paths.star_bam("{analysis}", "{assay}", "{pk}"),
    params:
        genomedir=lambda wc: paths.star_index_dir(SP(wc)),
        prefix=lambda wc: paths.star_prefix(wc.analysis, wc.assay, wc.pk),
    threads: THREADS
    shell:
        "mkdir -p $(dirname {params.prefix}) && "
        "STAR --soloType CB_UMI_Complex --soloCBwhitelist $(cat {input.whitelists}) "
        "--soloCBposition $(cat {input.positions}) --soloUMIposition $(cat {input.umi}) "
        "--soloBarcodeReadLength 0 --runThreadN {threads} --genomeDir {params.genomedir} "
        "--outFileNamePrefix {params.prefix} --readFilesIn {input.r0} {input.r1} "
        "--readFilesCommand zcat --soloCBmatchWLtype 1MM --outSAMtype BAM SortedByCoordinate"


rule samtools_index:
    wildcard_constraints:
        bam=r".*/STARsolo/[A-Za-z0-9_]+Aligned\.sortedByCoord\.out",
    input:
        "{bam}.bam",
    output:
        "{bam}.bam.bai",
    shell:
        "samtools index {input}"


rule genebody_coverage:
    # RSeQC gene-body coverage over a group's four BAMs, restricted to housekeeping
    # transcripts (much faster than the full BED). One plot per comparison group.
    input:
        bed=lambda wc: paths.hk_bed_file(SP(wc)),
        bams=genebody_bams,
        bais=lambda wc: [b + ".bai" for b in genebody_bams(wc)],
    output:
        paths.genebody_marker("{analysis}", "{tag}"),
    params:
        prefix=lambda wc: paths.genebody_prefix(wc.analysis, wc.tag),
        plotdir=lambda wc: paths.plots_dir(wc.analysis),
        bams_csv=lambda wc: ",".join(genebody_bams(wc)),
    shell:
        "mkdir -p {params.plotdir} && "
        "geneBody_coverage.py -r {input.bed} -i {params.bams_csv} -o {params.prefix}"
